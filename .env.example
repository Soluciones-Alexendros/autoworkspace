# Ejemplo de variables de entorno para autoworkspace.
# Copia a `.env` (no versionado) y carga con: set -a; . ./.env; set +a
# o `make` si el objetivo carga el fichero cuando existe. Ver docs/USAGE.md.

# --- Mantenimiento local (opcional; defaults seguros bajo $HOME / XDG) ---
# Directorio de snapshots reversibles. Obligatorio solo si usas snapshot_state sin flag.
SNAPSHOT_DIR=
# Directorio de logs de sesión de mantenimiento. Default: /var/log/... con fallback /tmp.
LOG_DIR=
# Identificador de sesión de log. Default: session-<timestamp UTC>.
SESSION_ID=
# Si "true", algunos scripts emiten JSON en stdout.
OUTPUT_JSON=false
# Si está definido, desactiva color ANSI en salida.
NO_COLOR=

# --- Proton driver (local-email); secretos reales solo en .env local o Pass ---
PROTON_IMAP_HOST=127.0.0.1
PROTON_IMAP_PORT=1143
PROTON_SMTP_HOST=127.0.0.1
PROTON_SMTP_PORT=1025
# Usuario Bridge (obligatorio para mail real). Ejemplo:
PROTON_USER=user@example.com
# Contraseña Bridge (obligatoria para mail real). Dejar vacío en el ejemplo.
PROTON_PASS=

# --- Capa tools/execution ---
# deny | allow | prompt — default deny (solo lectura / sin mutación).
AUTOWORKSPACE_APPROVAL_PROVIDER=deny
# "1" permite red en preflight; default ausente = sin red.
AUTOWORKSPACE_ALLOW_NETWORK=
# Patrones privados (uno por línea, separados por coma o newline) para hygiene local.
# En CI: secreto de repo HYGIENE_DENYLIST (si falta → paso not_run, nunca verde falso).
AUTOWORKSPACE_PRIVATE_PATTERNS=
