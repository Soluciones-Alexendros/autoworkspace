# Copia a `.env` en local. Nunca commitees `.env`.
# Este canon no tiene runtime: las claves son placeholders de contrato
# para que los repos P1 copien el archivo y lo rellenen.

# Entorno de la app (development | test | production)
# APP_ENV=development

# URL pública o de preview local
# APP_URL=http://localhost:3000

# Proveedores (ejemplos — sustituye por las keys reales del producto)
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/APP
# AUTH_SECRET=replace-with-a-long-random-string

# CI y smoke deben poder arrancar con este archivo (valores fake / mocks).
# No pongas tokens reales. Si una key se usa en código, debe existir aquí
# (el job `check:env` de producto compara .env.example vs keys leídas).
