# Ignorar contenido de .cursor/ salvo el harness versionado (hooks, rules, agents, skills).
# Usar .cursor/* (no .cursor/) para que las negaciones puedan reincluir hijos.
.cursor/*
!.cursor/hooks.json
!.cursor/hooks/
!.cursor/hooks/*.py
!.cursor/rules/
!.cursor/rules/*.mdc
!.cursor/agents/
!.cursor/agents/*.md
!.cursor/skills/
!.cursor/skills/*/
# Estado local de hooks (continual-learning, etc.)
.cursor/hooks/state/

# Env local (P11 T4)
.env
.env.*
!.env.example

# Diagramas: el HTML es artefacto de CI, no se versiona (P12 T5)
docs/architecture/diagrams/rendered/
.cache/

# Informes reales de local-maintenance (salida audit-quick). Fixtures aprobadas
# viven bajo **/fixtures/** o **/testdata/** y no usan este patrón con timestamp.
skills/**/audit-quick-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9].json
