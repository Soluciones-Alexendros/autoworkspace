{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Madrid",
  "schedule": ["before 7am"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 7am on monday"]
  },
  "github-actions": {
    "pinDigests": true
  },
  "packageRules": [
    {
      "description": "Patch, pin y digest: sin automerge",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": false
    },
    {
      "description": "Agrupar minors: sin automerge",
      "matchUpdateTypes": ["minor"],
      "groupName": "minor dependencies",
      "automerge": false
    },
    {
      "description": "Majors: revisi\u00f3n humana, cuarentena ampliada, sin automerge",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "14 days",
      "automerge": false
    },
    {
      "description": "Agrupar GitHub Actions no-major: sin automerge",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github-actions",
      "automerge": false
    },
    {
      "description": "Autoworkspace: agrupar bumps Python (pip_requirements + pep621): sin automerge",
      "matchManagers": ["pip_requirements", "pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python deps (minor + patch)",
      "automerge": false
    },
    {
      "description": "Archify (renderer de diagramas): subir el pin cambia los cuatro HTML, sin automerge",
      "matchDatasources": ["git-refs"],
      "matchPackageNames": ["tt-a1i/archify"],
      "groupName": "archify",
      "automerge": false,
      "minimumReleaseAge": "3 days",
      "labels": ["hold", "policy-exception"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pin de Archify en el cat\u00e1logo de diagramas (P12 T5)",
      "managerFilePatterns": [
        "/^docs\\/architecture\\/diagrams\\/catalog\\.json$/"
      ],
      "matchStrings": [
        "\"repo\":\\s*\"(?<depName>[^\"]+)\",\\s*\"sha\":\\s*\"(?<currentValue>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Pin de Archify en el job diagrams de ci.yml (P12 T5)",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/ci\\.yml$/"],
      "matchStrings": [
        "repository:\\s*tt-a1i/archify\\n\\s*ref:\\s*(?<currentValue>[0-9a-f]{40})"
      ],
      "depNameTemplate": "tt-a1i/archify",
      "datasourceTemplate": "git-refs"
    }
  ]
}
