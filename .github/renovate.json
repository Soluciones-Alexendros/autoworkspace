{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Madrid",
  "schedule": ["before 7am"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "dependencyDashboard": true,
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 7am on monday"]
  },
  "github-actions": { "pinDigests": true },
  "packageRules": [
    {
      "description": "Automerge patch, pin y digest",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Agrupar y automergear minors",
      "matchUpdateTypes": ["minor"],
      "groupName": "minor dependencies",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Majors: revisión humana, sin automerge",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Agrupar GitHub Actions no-major",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github-actions",
      "automerge": true
    },
    {
      "description": "Autoworkspace: agrupar bumps Python (pip_requirements + pep621) con el resto de minor/patch",
      "matchManagers": ["pip_requirements", "pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python deps (minor + patch)",
      "automerge": true
    }
  ]
}
