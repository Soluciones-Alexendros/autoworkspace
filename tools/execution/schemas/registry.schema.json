{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoworkspace.local/schemas/execution-registry.schema.json",
  "title": "Autoworkspace central execution registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dialect", "tools"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "dialect": {
      "type": "string",
      "const": "autoworkspace.execution.registry"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "skill",
          "entrypoint",
          "description",
          "execution_kind",
          "distribution",
          "operations"
        ],
        "properties": {
          "tool_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "skill": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "entrypoint": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "execution_kind": {
            "type": "string",
            "enum": ["agent", "script", "orchestrator"]
          },
          "distribution": {
            "type": "string",
            "enum": ["standalone", "workspace-required"]
          },
          "shared_dependencies": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "system_requirements": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "binaries": { "type": "array", "items": { "type": "string" } },
              "network": { "type": "boolean" },
              "harness_capabilities": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "allowed_tools_override": {
            "type": "array",
            "items": { "type": "string" }
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "effect", "dry_run", "idempotency"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "effect": {
                  "type": "string",
                  "enum": [
                    "read",
                    "write-workspace",
                    "mutate-host",
                    "communicate-external",
                    "access-secret"
                  ]
                },
                "dry_run": {
                  "type": "string",
                  "enum": ["yes", "no", "unknown"]
                },
                "idempotency": {
                  "type": "string",
                  "enum": ["yes", "no", "unknown"]
                },
                "approval_required": { "type": "boolean" },
                "recovery_required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            }
          },
          "handoffs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["skill"],
              "properties": {
                "skill": { "type": "string" },
                "when": { "type": "string" }
              }
            }
          },
          "automation_limits": { "type": "string" },
          "normative_sources": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
