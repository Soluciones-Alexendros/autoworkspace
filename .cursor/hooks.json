{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/session_start.py"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/shell_gate.py",
        "failClosed": true,
        "timeout": 10,
        "matcher": "\\b(?:apt-get|sshd|apt|dnf|pacman|systemctl|mkfs|shutdown|reboot|iptables|nft|ufw|curl|wget|nc|ssh|scp|sudo)\\b|\\brm\\s+-rf\\b|\\bdd\\s+if="
      }
    ]
  }
}
