{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Madrid",
  "schedule": ["before 7am"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 7am on monday"]
  },
  "packageRules": [
    {
      "description": "Patch, pin y digest: sin automerge",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": false
    },
    {
      "description": "Agrupar minors: sin automerge",
      "matchUpdateTypes": ["minor"],
      "groupName": "minor dependencies",
      "automerge": false
    },
    {
      "description": "Majors: revisión humana, cuarentena ampliada, sin automerge",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "14 days",
      "automerge": false
    },
    {
      "description": "Agrupar GitHub Actions no-major: sin automerge",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github-actions",
      "automerge": false
    }
  ]
}
